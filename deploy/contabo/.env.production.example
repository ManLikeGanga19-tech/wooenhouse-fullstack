# Wooden Houses Kenya — production env (Contabo)
#
# Copy to `.env.production` on the box (or inject via the CI PRODUCTION_ENV_FILE
# secret). NEVER commit the real file — it is gitignored.
# .NET reads nested config keys with the "__" separator (Section__Key).

# ─── External Docker network names (must match the box) ───────────────────────
# DEDICATED networks so WHK reaches ONLY the edge proxy and ONLY Postgres —
# never ShuleHQ's app containers (playbook §3). Create them once on the box:
#   docker network create whk-edge-net && docker network connect whk-edge-net sms-caddy
#   docker network create whk-db-net   && docker network connect whk-db-net   sms-postgres
#
# Do NOT use shulehq_backend-net: it also carries sms-backend / sms-redis /
# sms-nginx, which would put WHK on the same L2 as ShuleHQ's application tier.
EDGE_NETWORK=whk-edge-net
POSTGRES_NETWORK=whk-db-net
IMAGE_TAG=latest

# ─── Database — shared Postgres 18, WHK's OWN database + role ──────────────────
# Host = the Postgres container name reachable on POSTGRES_NETWORK.
ConnectionStrings__DefaultConnection=Host=sms-postgres;Port=5432;Database=woodenhouses;Username=woodenhouses;Password=CHANGE_ME_STRONG;Pooling=true;MinPoolSize=2;MaxPoolSize=20;CommandTimeout=30

# ─── Auth ─────────────────────────────────────────────────────────────────────
Jwt__Key=CHANGE_ME_BASE64_64_BYTES
Jwt__Issuer=woodenhouseskenya.com
Jwt__Audience=woodenhouseskenya.com
Jwt__ExpiryHours=8
Jwt__RefreshExpiryDays=7

# ─── CORS ─────────────────────────────────────────────────────────────────────
Cors__AllowedOrigins=https://woodenhouseskenya.com,https://www.woodenhouseskenya.com,https://admin.woodenhouseskenya.com

# ─── Email (Resend, over HTTPS) ───────────────────────────────────────────────
Resend__ApiKey=re_CHANGE_ME
Email__AdminNotifyAddress=director@woodenhouseskenya.com

# ─── AI agents (Claude) ───────────────────────────────────────────────────────
Claude__ApiKey=sk-ant-CHANGE_ME
Claude__Model=claude-sonnet-4-6
CLAUDE_MAX_CONCURRENCY=3

# ─── Media (Contabo Object Storage, S3-compatible) ────────────────────────────
S3__ServiceUrl=https://eu2.contabostorage.com
S3__Region=us-east-1
S3__Bucket=woodenhouses-media
S3__AccessKey=CHANGE_ME
S3__SecretKey=CHANGE_ME
# Public base for serving images (bucket must be public-read, or front it with a CDN):
S3__PublicBaseUrl=https://eu2.contabostorage.com/woodenhouses-media

# ─── Spam (reCAPTCHA v3 secret; the SITE key is a frontend BUILD arg below) ────
Recaptcha__SecretKey=CHANGE_ME

# ─── URLs used in emails ──────────────────────────────────────────────────────
Frontend__Url=https://woodenhouseskenya.com
Frontend__AdminUrl=https://admin.woodenhouseskenya.com

# ─── Pricing + ops ────────────────────────────────────────────────────────────
Pricing__UsdToKes=130
SystemUpdate__Recipients=ericabuto@gmail.com,orwenjodaniel19@gmail.com

# ─── Mailbox (IMAP) — match the MailboxConfig shape (one entry per account) ────
# Mailboxes__ImapHost=imap.example.com
# Mailboxes__Accounts__0__Email=info@woodenhouseskenya.com
# Mailboxes__Accounts__0__Password=CHANGE_ME

# ─── First-run admin seed ─────────────────────────────────────────────────────
Seed__AdminEmail=info@woodenhouseskenya.com
Seed__AdminName=Mr Eric Abuto
Seed__AdminPassword=CHANGE_ME_STRONG

# ══════════════════════════════════════════════════════════════════════════════
# FRONTEND BUILD ARGS — inlined at BUILD time, passed to `docker build` in CI.
# These are NOT runtime env; setting them here does nothing for the frontend.
# Getting NEXT_PUBLIC_RECAPTCHA_SITE_KEY wrong = the reCAPTCHA-blank-key bug.
# ══════════════════════════════════════════════════════════════════════════════
# NEXT_PUBLIC_API_URL=https://api.woodenhouseskenya.com
# NEXT_PUBLIC_SITE_URL=https://woodenhouseskenya.com
# NEXT_PUBLIC_ADMIN_URL=https://admin.woodenhouseskenya.com
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6L...   (must pair with Recaptcha__SecretKey above)
# NEXT_PUBLIC_TAWKTO_PROPERTY_ID=...
# NEXT_PUBLIC_TAWKTO_WIDGET_ID=...
